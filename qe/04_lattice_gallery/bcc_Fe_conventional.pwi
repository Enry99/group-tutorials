! bcc Fe in the 2-atom CONVENTIONAL cubic cell, written with ibrav = 0.
! Energy per atom = bcc_Fe.pwi within the k-point error if the k-SPACING is similar:
! 16x16x16 in the primitive cell ~ 11-12 per direction here (tools/kgrid.py).
! Structure lines are commented; the rest is a minimal group-default SCF.

&CONTROL
  calculation = 'scf'
  prefix      = 'bcc_Fe_conventional'
  outdir      = './WORK'
  pseudo_dir  = '/leonardo/pub/userexternal/epedrett/pseudo'
  tprnfor     = .true.
  tstress     = .true.
  disk_io     = 'none'
/

&SYSTEM
  ibrav = 0               ! cell given explicitly in CELL_PARAMETERS
  nat   = 2
  ntyp  = 1
  ecutwfc = 60, ecutrho = 480
  occupations = 'smearing', smearing = 'gaussian', degauss = 0.00735
  nspin = 2
  starting_magnetization(1) = 0.4   ! species 1 = Fe
/

&ELECTRONS
  conv_thr = 1.0d-8, mixing_beta = 0.3
/

ATOMIC_SPECIES
Fe    55.845  Fe.pbe-sp-van.UPF

CELL_PARAMETERS angstrom
  2.866  0.000  0.000
  0.000  2.866  0.000
  0.000  0.000  2.866

K_POINTS automatic
12 12 12   0 0 0

ATOMIC_POSITIONS crystal
Fe  0.0  0.0  0.0
Fe  0.5  0.5  0.5
