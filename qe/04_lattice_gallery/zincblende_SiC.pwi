! zincblende (B3, F-43m No. 216): 3C-SiC. Diamond with two species (also GaAs, BN).
! Structure lines are commented; the rest is a minimal group-default SCF.

&CONTROL
  calculation = 'scf'
  prefix      = 'zincblende_SiC'
  outdir      = './WORK'
  pseudo_dir  = '/leonardo/pub/userexternal/epedrett/pseudo'
  tprnfor     = .true.
  tstress     = .true.
  disk_io     = 'none'
/

&SYSTEM
  ibrav = 2
  A     = 4.360           ! Angstrom, exp.
  nat   = 2
  ntyp  = 2
  ecutwfc = 60, ecutrho = 480
  occupations = 'smearing', smearing = 'gaussian', degauss = 0.00735
/

&ELECTRONS
  conv_thr = 1.0d-8, mixing_beta = 0.3
/

ATOMIC_SPECIES
Si    28.085  Si.pbe-n-rrkjus_psl.1.0.0.UPF
C     12.011  C.pbe-n-kjpaw_psl.1.0.0.UPF

K_POINTS automatic
9 9 9   0 0 0

ATOMIC_POSITIONS crystal
Si  0.00  0.00  0.00
C   0.25  0.25  0.25
