! 2H-MoS2 (C7, P6_3/mmc No. 194): two S-Mo-S layers per cell, held by van der Waals forces.
! Without a dispersion correction (vdw_corr) the layers drift apart in vc-relax.
! Structure lines are commented; the rest is a minimal group-default SCF.

&CONTROL
  calculation = 'scf'
  prefix      = 'layered_MoS2_2H'
  outdir      = './WORK'
  pseudo_dir  = '/leonardo/pub/userexternal/epedrett/pseudo'
  tprnfor     = .true.
  tstress     = .true.
  disk_io     = 'none'
/

&SYSTEM
  ibrav = 4
  A     = 3.160           ! Angstrom, exp.
  C     = 12.29           ! Angstrom, exp. (2 layers)
  nat   = 6
  ntyp  = 2
  ecutwfc = 60, ecutrho = 480
  occupations = 'smearing', smearing = 'gaussian', degauss = 0.00735
  vdw_corr = 'dft-d3'      ! essential here: interlayer binding is dispersion
/

&ELECTRONS
  conv_thr = 1.0d-8, mixing_beta = 0.3
/

ATOMIC_SPECIES
Mo     95.95  Mo.pbe-spn-kjpaw_psl.1.0.0.UPF
S      32.06  S.pbe-n-kjpaw_psl.1.0.0.UPF

K_POINTS automatic
10 10 3   0 0 0

ATOMIC_POSITIONS crystal
Mo  0.3333333333  0.6666666667  0.250
Mo  0.6666666667  0.3333333333  0.750
S   0.6666666667  0.3333333333  0.121     ! S at z(Mo) -/+ 0.129: trigonal prism
S   0.6666666667  0.3333333333  0.379
S   0.3333333333  0.6666666667  0.621
S   0.3333333333  0.6666666667  0.879
