! wurtzite (B4, P6_3mc No. 186): ZnO. Same for GaN, AlN.
! Structure lines are commented; the rest is a minimal group-default SCF.

&CONTROL
  calculation = 'scf'
  prefix      = 'wurtzite_ZnO'
  outdir      = './WORK'
  pseudo_dir  = '/leonardo/pub/userexternal/epedrett/pseudo'
  tprnfor     = .true.
  tstress     = .true.
  disk_io     = 'none'
/

&SYSTEM
  ibrav = 4
  A     = 3.250           ! Angstrom, exp.
  C     = 5.207           ! Angstrom, exp.
  nat   = 4
  ntyp  = 2
  ecutwfc = 60, ecutrho = 480
  occupations = 'smearing', smearing = 'gaussian', degauss = 0.00735
/

&ELECTRONS
  conv_thr = 1.0d-8, mixing_beta = 0.3
/

ATOMIC_SPECIES
Zn     65.38  Zn.pbe-dnl-kjpaw_psl.1.0.0.UPF
O     15.999  O.pbe-n-kjpaw_psl.1.0.0.UPF

K_POINTS automatic
10 10 6   0 0 0

ATOMIC_POSITIONS crystal
Zn  0.3333333333  0.6666666667  0.000
Zn  0.6666666667  0.3333333333  0.500
O   0.3333333333  0.6666666667  0.382     ! u = 0.382
O   0.6666666667  0.3333333333  0.882
