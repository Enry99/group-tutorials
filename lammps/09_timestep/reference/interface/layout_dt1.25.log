# Timestep test in the layout of a sliding or indentation run, at constant
# load and without sliding: fixed layer, thermostatted layers (Nose-Hoover on
# the temperature without the COM motion, as in 05_sliding), NVE in between,
# constant normal force on the top layer. With thermostats the conserved
# quantity is econserve = etotal + ecouple (ecouple: energy taken by the
# thermostats), so its drift is the integration error. In the inner NVE
# region (the interface) that error becomes heat: its temperature, H and
# other atoms apart, is compared with the thermostat temperature.
# Usage: sbatch job_scan.sh layout.in      (one job per dt)
# Needs: a restart at the end of the load stage (05_sliding/01_load.in ->
#        load.restart, or yours), or a data file + groups file
#
# Printed: econserve, etotal, ecouple; c_ts_Tin, c_ts_TinH, c_ts_TinX (inner
# region: all, H, other atoms); the thermostatted groups; v_gap; v_dxH,
# c_ts_nfree, v_nH2 as in nve.in; "TS_RESULT ..." at the end.

# ---------- settings ----------
variable  model     string CHANGE_ME.model-mliap_lammps.pt   # MLIP in ML-IAP format (00_basics)
variable  elements  string "C H"    # element of each atom type, in type order
variable  tH        equal  2      # atom type of H
variable  read      string restart        # restart: read_restart; data: read_data + groups file
variable  start     string load.restart
variable  groups    string NULL           # groups file, read if it exists (NULL: none)
variable  bnd       string "p p p"        # boundary for read_data
variable  fixed     string layer_bot      # fixed groups (forces zero, not integrated)
variable  thermo_g  string "thermo_bot thermo_top"   # thermostatted groups, one thermostat each
variable  load_g    string layer_top      # group with the load
variable  rigid     equal  0              # 1: load group as a rigid body (fix rigid/nve single)
variable  P         equal  1.0            # GPa on lx*ly (0: no load)
variable  T         index  300            # K
variable  dt        index  0.5            # fs (index: set it with -var dt 1.0)
variable  mH        index  0              # > 0: mass of the H type, e.g. 2.014 (deuterium)
variable  tag       index  layout_dt${dt} # name of the output files
variable  tag       index  layout_dt1.25 
variable  t_run     equal  5              # ps
variable  t_out     equal  0.015          # ps between thermo lines: whole steps for dt 0.25-1.5 fs
variable  tdamp     equal  0.1            # ps, the same for every dt (100*dt would change with dt)
variable  rc_HX     equal  2.0            # A, as in nve.in
variable  rc_HH     equal  1.0            # A, as in nve.in
variable  neigh_every equal 1             # as in your production runs (neigh_modify every N)

# ---------- system ----------
units           metal                     # A, ps, eV, bar, K
atom_style      atomic
if "${read} == restart" then "read_restart ${start}" else   "boundary ${bnd}" "read_data ${start}"
read_restart ${start}
read_restart load.restart
Reading restart file ...
  restart file = 22 Jul 2025, LAMMPS = 22 Jul 2025
  restoring atom style atomic from restart
  triclinic box = (0 0 0) to (10.089 8.7373299 33.864971) with tilt (5.0444998 0 0)
WARNING: Triclinic box skew is large. LAMMPS will run inefficiently. (src/domain.cpp:221)
  1 by 1 by 1 MPI processor grid
  pair style rebo stores no restart info
  384 atoms
  read_restart CPU = 0.000 seconds
variable        has_groups equal is_file(${groups})
variable        has_groups equal is_file(NULL)
if "${has_groups}" then "include ${groups}"
reset_timestep  0
pair_style      rebo
pair_coeff      * * CH.rebo ${elements}
pair_coeff      * * CH.rebo C H
Reading rebo potential file CH.rebo with DATE: 2018-7-3
neigh_modify    every ${neigh_every} delay 0 check yes
neigh_modify    every 1 delay 0 check yes

# ---------- groups of the test ----------
group           ts_none   empty
0 atoms in group ts_none
group           ts_fix    union ${fixed}
group           ts_fix    union layer_bot
16 atoms in group ts_fix
group           ts_th     union ${thermo_g}
group           ts_th     union thermo_bot thermo_top
128 atoms in group ts_th
group           ts_load   union ${load_g}
group           ts_load   union layer_top
16 atoms in group ts_load
group           ts_md     subtract all ts_fix
368 atoms in group ts_md
group           ts_in     subtract all ts_fix ts_th ts_load   # inner NVE region
224 atoms in group ts_in
group           ts_Hall   type ${tH}
group           ts_Hall   type 2
64 atoms in group ts_Hall
# new H mass: velocities scaled by sqrt(m_old/m_new), so the kinetic energy (T) is kept
if "${mH} > 0" then   "variable ts_f equal $(sqrt(mass(ts_Hall)/count(ts_Hall)/v_mH))"   "variable ts_vx atom vx*v_ts_f" "variable ts_vy atom vy*v_ts_f" "variable ts_vz atom vz*v_ts_f"   "velocity ts_Hall set v_ts_vx v_ts_vy v_ts_vz units box"   "mass ${tH} ${mH}"
group           ts_Xall   subtract all ts_Hall
320 atoms in group ts_Xall
group           ts_inH    intersect ts_in ts_Hall
32 atoms in group ts_inH
group           ts_inX    subtract ts_in ts_inH
192 atoms in group ts_inX
variable        nmd equal count(ts_md)
print           "TS_TEST dt ${dt} fs, mH ${mH}, tag ${tag}, atoms that move ${nmd}, H in the inner region $(count(ts_inH)), thermostat ${T} K"
TS_TEST dt 1.25 fs, mH 0, tag layout_dt1.25, atoms that move 368, H in the inner region 32, thermostat 800 K

# ---------- integration ----------
timestep        $(v_dt*0.001)             # ps
timestep        0.001250000000000000026             
fix             ts_hold   ts_fix  setforce 0.0 0.0 0.0
if "${read} == data" then "velocity ts_md create ${T} 4928459 dist gaussian mom yes rot no"
velocity        ts_fix set 0.0 0.0 0.0
fix             ts_nve    ts_in   nve
if "${rigid} == 1" then "fix ts_rig ts_load rigid/nve single" else "fix ts_nveload ts_load nve"
fix ts_nveload ts_load nve
variable        fz equal -v_P*1.0e9*lx*ly*1.0e-20/ternary(count(ts_load)>0,count(ts_load),1)/1.602176634e-9   # eV/A per atom
if "${P} > 0" then   "fix ts_load ts_load addforce 0.0 0.0 $(v_fz)"   "fix_modify ts_load energy yes"         # energy of the constant force, in pe and econserve
fix ts_load ts_load addforce 0.0 0.0 $(v_fz)
fix ts_load ts_load addforce 0.0 0.0 -0.034387172003820000443
fix_modify ts_load energy yes

# one Nose-Hoover thermostat per group, each with its temperature without COM motion
variable        thcols string c_ts_Tin        # thermo columns: inner region, then each thermostat
variable        tg index ${thermo_g}
variable        tg index thermo_bot thermo_top
label           ts_loop
  compute       ts_T_${tg} ${tg} temp/com
  compute       ts_T_thermo_bot ${tg} temp/com
  compute       ts_T_thermo_bot thermo_bot temp/com
  fix           ts_nvt_${tg} ${tg} nvt temp ${T} ${T} ${tdamp}
  fix           ts_nvt_thermo_bot ${tg} nvt temp ${T} ${T} ${tdamp}
  fix           ts_nvt_thermo_bot thermo_bot nvt temp ${T} ${T} ${tdamp}
  fix           ts_nvt_thermo_bot thermo_bot nvt temp 800 ${T} ${tdamp}
  fix           ts_nvt_thermo_bot thermo_bot nvt temp 800 800 ${tdamp}
  fix           ts_nvt_thermo_bot thermo_bot nvt temp 800 800 0.1
Resetting global fix info from restart file:
  fix style: nvt, fix ID: ts_nvt_thermo_bot
  fix_modify    ts_nvt_${tg} temp ts_T_${tg}
  fix_modify    ts_nvt_thermo_bot temp ts_T_${tg}
  fix_modify    ts_nvt_thermo_bot temp ts_T_thermo_bot
WARNING: Temperature for fix modify is not for group all (src/fix_nh.cpp:1402)
  variable      thcols string "${thcols} c_ts_T_${tg}"
c_ts_Tin c_ts_T_${tg}
c_ts_Tin c_ts_T_thermo_bot
next            tg
jump            SELF ts_loop
  compute       ts_T_${tg} ${tg} temp/com
  compute       ts_T_thermo_top ${tg} temp/com
  compute       ts_T_thermo_top thermo_top temp/com
  fix           ts_nvt_${tg} ${tg} nvt temp ${T} ${T} ${tdamp}
  fix           ts_nvt_thermo_top ${tg} nvt temp ${T} ${T} ${tdamp}
  fix           ts_nvt_thermo_top thermo_top nvt temp ${T} ${T} ${tdamp}
  fix           ts_nvt_thermo_top thermo_top nvt temp 800 ${T} ${tdamp}
  fix           ts_nvt_thermo_top thermo_top nvt temp 800 800 ${tdamp}
  fix           ts_nvt_thermo_top thermo_top nvt temp 800 800 0.1
Resetting global fix info from restart file:
  fix style: nvt, fix ID: ts_nvt_thermo_top
  fix_modify    ts_nvt_${tg} temp ts_T_${tg}
  fix_modify    ts_nvt_thermo_top temp ts_T_${tg}
  fix_modify    ts_nvt_thermo_top temp ts_T_thermo_top
WARNING: Temperature for fix modify is not for group all (src/fix_nh.cpp:1402)
  variable      thcols string "${thcols} c_ts_T_${tg}"
c_ts_Tin c_ts_T_thermo_bot c_ts_T_${tg}
c_ts_Tin c_ts_T_thermo_bot c_ts_T_thermo_top
next            tg
jump            SELF ts_loop

# ---------- what to check ----------
compute         ts_Tin  ts_in  temp
compute_modify  ts_Tin  extra/dof 0
compute         ts_TinH ts_inH temp
compute_modify  ts_TinH extra/dof 0
compute         ts_TinX ts_inX temp
compute_modify  ts_TinX extra/dof 0
variable        ts_v2 atom vx*vx+vy*vy+vz*vz
compute         ts_v2max ts_Hall reduce max v_ts_v2
variable        dxH equal sqrt(c_ts_v2max)*dt
compute         ts_cnHX ts_Hall coord/atom cutoff ${rc_HX} group ts_Xall
compute         ts_cnHX ts_Hall coord/atom cutoff 2 group ts_Xall
compute         ts_cnHH ts_Hall coord/atom cutoff ${rc_HH} group ts_Hall
compute         ts_cnHH ts_Hall coord/atom cutoff 1 group ts_Hall
variable        ts_free atom "c_ts_cnHX==0 && c_ts_cnHH==0"
variable        ts_inH2 atom "c_ts_cnHX==0 && c_ts_cnHH==1"
compute         ts_nfree ts_Hall reduce sum v_ts_free
compute         ts_nH2   ts_Hall reduce sum v_ts_inH2
variable        nH2 equal c_ts_nH2/2
variable        gap equal xcm(ts_load,z)-xcm(ts_fix,z)

variable        nout equal round(v_t_out/dt)
variable        nrun equal v_nout*round(v_t_run/v_t_out)   # a multiple of nout
fix             ts_avg all ave/time ${nout} $(v_nrun/v_nout) ${nrun} c_ts_TinH c_ts_TinX
fix             ts_avg all ave/time 12 $(v_nrun/v_nout) ${nrun} c_ts_TinH c_ts_TinX
fix             ts_avg all ave/time 12 333 ${nrun} c_ts_TinH c_ts_TinX
fix             ts_avg all ave/time 12 333 3996 c_ts_TinH c_ts_TinX

thermo          ${nout}
thermo          12
thermo_style    custom step time econserve etotal pe ke ecouple ${thcols} c_ts_TinH c_ts_TinX                 v_gap v_dxH c_ts_nfree v_nH2
thermo_style    custom step time econserve etotal pe ke ecouple c_ts_Tin c_ts_T_thermo_bot c_ts_T_thermo_top c_ts_TinH c_ts_TinX                 v_gap v_dxH c_ts_nfree v_nH2
thermo_modify   flush yes
dump            ts_traj all custom $(round(0.5/dt)) ${tag}.lammpstrj id element xu yu zu
dump            ts_traj all custom 400 ${tag}.lammpstrj id element xu yu zu
dump            ts_traj all custom 400 layout_dt1.25.lammpstrj id element xu yu zu
dump_modify     ts_traj element ${elements} sort id
dump_modify     ts_traj element C H sort id

