# Uniaxial deformation at constant strain rate: stress-strain curve.
# The cell is stretched (or compressed) along x at engineering strain rate
# erate; y and z are kept at zero pressure by the barostat (uniaxial stress).
# Usage: sbatch job.sh uniaxial.in     Needs: Fe_bcc.data
# Output: stress_strain.txt (strain, then sxx syy szz in GPa, positive = tensile)

# ---------- settings ----------
variable  model     string CHANGE_ME.model-mliap_lammps.pt   # MLIP in ML-IAP format (00_basics)
variable  elements  string "Fe"           # element of each atom type, in the order of the data file
variable  T         equal  300            # K
variable  srate     equal  1.0e9          # 1/s, engineering strain rate; negative = compression
variable  strain    equal  0.20           # final strain (absolute value)
variable  t_eq      equal  20             # ps, NPT equilibration at zero pressure

# ---------- system ----------
units           metal                     # A, ps, eV, bar, K
atom_style      atomic
boundary        p p p
read_data       Fe_bcc.data
Reading data file ...
  orthogonal box = (0 0 0) to (14.33 14.33 14.33)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  250 atoms
  read_data CPU = 0.001 seconds

# ---------- potential ----------
pair_style      eam/fs
pair_coeff      * * Fe_mm.eam.fs Fe
Reading eam/fs potential file Fe_mm.eam.fs with DATE: 2007-06-11

timestep        0.001
variable        tdamp equal 100.0*dt
variable        pdamp equal 1000.0*dt
velocity        all create ${T} 8541 dist gaussian mom yes rot yes
velocity        all create 300 8541 dist gaussian mom yes rot yes

# ---------- 1. equilibration at zero pressure ----------
thermo          1000
thermo_style    custom step time temp pe press lx ly lz
fix             md all npt temp ${T} ${T} ${tdamp} aniso 0.0 0.0 ${pdamp}
fix             md all npt temp 300 ${T} ${tdamp} aniso 0.0 0.0 ${pdamp}
fix             md all npt temp 300 300 ${tdamp} aniso 0.0 0.0 ${pdamp}
fix             md all npt temp 300 300 0.1 aniso 0.0 0.0 ${pdamp}
fix             md all npt temp 300 300 0.1 aniso 0.0 0.0 1
variable        lxi equal lx
fix             lav all ave/time 10 $(round(v_t_eq/dt/20)) $(round(v_t_eq/dt)) v_lxi   # mean lx, 2nd half
fix             lav all ave/time 10 1000 $(round(v_t_eq/dt)) v_lxi   
fix             lav all ave/time 10 1000 20000 v_lxi   
run             $(round(v_t_eq/dt))
run             20000
