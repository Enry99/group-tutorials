variable        L0 equal $(lx)            # reference length (evaluated now, then constant)
variable        L0 equal 14.235117275382497937            
print           "L0 = ${L0} A"
L0 = 14.2351172753825 A

# ---------- 2. deformation ----------
# erate is in 1/ps in metal units: 1e9 1/s = 1e-3 1/ps
variable        erate equal v_srate/1.0e12
fix             md all npt temp ${T} ${T} ${tdamp} y 0.0 0.0 ${pdamp} z 0.0 0.0 ${pdamp}
fix             md all npt temp 300 ${T} ${tdamp} y 0.0 0.0 ${pdamp} z 0.0 0.0 ${pdamp}
fix             md all npt temp 300 300 ${tdamp} y 0.0 0.0 ${pdamp} z 0.0 0.0 ${pdamp}
fix             md all npt temp 300 300 0.1 y 0.0 0.0 ${pdamp} z 0.0 0.0 ${pdamp}
fix             md all npt temp 300 300 0.1 y 0.0 0.0 1 z 0.0 0.0 ${pdamp}
fix             md all npt temp 300 300 0.1 y 0.0 0.0 1 z 0.0 0.0 1
fix             stretch all deform 1 x erate ${erate} units box remap x
fix             stretch all deform 1 x erate 0.001 units box remap x

# strain and stresses in GPa (pressure is in bar; stress = -pressure, so
# a positive sxx is tensile)
variable        eps equal (lx-v_L0)/v_L0
variable        sxx equal -pxx/10000
variable        syy equal -pyy/10000
variable        szz equal -pzz/10000
fix             out all print 100 "${eps} ${sxx} ${syy} ${szz}" file stress_strain.txt screen no title "# strain sxx syy szz (GPa)"
thermo_style    custom step time temp pe press v_eps v_sxx v_syy v_szz   # press: needed by v_sxx
dump            traj all custom 1000 uniaxial.lammpstrj id element xu yu zu
dump_modify     traj element ${elements} sort id format float %15.12g
dump_modify     traj element Fe sort id format float %15.12g

run             $(round(abs(v_strain/v_erate)/dt))
run             200000
