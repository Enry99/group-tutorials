# Surface of an amorphous solid: open a vacuum gap in the melt-quenched bulk,
# anneal the new surfaces, cool down and minimize.
# Stages (NVT): heat T0 -> Ta, hold Ta, cool Ta -> T0, minimize.
# Usage: sbatch job.sh anneal_slab.in     Needs: meltquench.data (from meltquench.in)

# ---------- settings ----------
variable  model     string CHANGE_ME.model-mliap_lammps.pt   # MLIP in ML-IAP format (00_basics)
variable  elements  string "C"            # element of each atom type, in the order of the data file
variable  vacuum    equal  20.0           # A added along z (0: the data file is already a slab)
variable  T0        equal  300            # K
variable  Ta        equal  1500           # K, anneal: mobile surface, below melting
variable  t_heat    equal  20             # ps
variable  t_hold    equal  20             # ps
variable  t_cool    equal  40             # ps

# ---------- system ----------
units           metal                     # A, ps, eV, bar, K
atom_style      atomic
boundary        p p p
read_data       meltquench.data
Reading data file ...
  orthogonal box = (0 0 0) to (11.282021 11.282021 11.282021)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  216 atoms
  reading velocities ...
  216 velocities
  read_data CPU = 0.001 seconds
# the bulk is cut at the z boundary: two free surfaces, at the bottom and at the top
change_box      all z final $(zlo) $(zhi+v_vacuum) units box
change_box      all z final 0 $(zhi+v_vacuum) units box
change_box      all z final 0 31.282021429062055518 units box
Changing box ...
  orthogonal box = (0 0 0) to (11.282021 11.282021 31.282021)
displace_atoms  all move 0 0 $(v_vacuum/2) units box   # slab in the middle of the cell
displace_atoms  all move 0 0 10 units box   
Displacing atoms ...
# image flags from the bulk run are meaningless now: without this the
# unwrapped z (zu) of the atoms that crossed the z boundary is off by one cell
# (all three flags reset: "image NULL NULL 0" is ignored by some 2025 versions)
set             group all image 0 0 0
Setting atom values ...
  216 settings made for image

# ---------- potential ----------
pair_style      tersoff
pair_coeff      * * SiC.tersoff ${elements}
pair_coeff      * * SiC.tersoff C
Reading tersoff potential file SiC.tersoff with DATE: 2011-04-26

# ---------- output ----------
thermo          1000
thermo_style    custom step time temp pe etotal pxx pyy pzz
dump            traj all custom 1000 anneal_slab.lammpstrj id element xu yu zu
dump_modify     traj element ${elements} sort id format float %15.12g
dump_modify     traj element C sort id format float %15.12g

timestep        0.001
variable        tdamp equal 100.0*dt
velocity        all create ${T0} 7391 dist gaussian mom yes rot yes
velocity        all create 300 7391 dist gaussian mom yes rot yes

fix             thermostat all nvt temp ${T0} ${Ta} ${tdamp}
fix             thermostat all nvt temp 300 ${Ta} ${tdamp}
fix             thermostat all nvt temp 300 1500 ${tdamp}
fix             thermostat all nvt temp 300 1500 0.1
run             $(round(v_t_heat/dt))
run             20000
