# Molecules on a surface at high temperature: reactions (oxidation,
# dissociation, hydrolysis) followed by counting the molecules in the run.
# Stages: heat T0 -> Th, hold Th, cool Th -> T0, (optional) minimize.
# Usage: sbatch job.sh highT.in
# Needs: Fe_water.data, Fe_water.groups.lmp (structures/tools/interface.py --no-top)
#
# Groups: layer_bot fixed; thermo_bot thermostat; surf_bot NVE (the
# reacting surface); molecules thermostat (the heat of reaction goes out
# through the molecules and thermo_bot). A reflecting wall at the top of the
# box keeps the molecules in.

# ---------- settings ----------
variable  model     string CHANGE_ME.model-mliap_lammps.pt   # MLIP in ML-IAP format (00_basics)
variable  elements  string "Fe O H"       # element of each atom type, in the order of the data file
variable  tO        equal  2              # atom type of O ...
variable  tH        equal  3              # ... and of H (for the molecule counts)
variable  T0        equal  300            # K
variable  Th        equal  800            # K
variable  t_heat    equal  1000             # ps
variable  t_hold    equal  2000            # ps
variable  t_cool    equal  1000             # ps
variable  do_min    equal  1              # 1: minimize at the end (structure for DFT, analysis)

# ---------- system ----------
units           real                      # local check: ReaxFF needs real units (fs)
atom_style      charge
boundary        p p f                     # z not periodic: the wall closes the box at the top
read_data       Fe_water_q.data
Reading data file ...
  orthogonal box = (0 0 0) to (19.85623 21.060713 40.733427)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  1025 atoms
  read_data CPU = 0.005 seconds
include         Fe_water.groups.lmp
# groups for Fe_water.data, written by interface.py
group layer_bot   id <> 1 72
72 atoms in group layer_bot
group thermo_bot  id <> 73 288
216 atoms in group thermo_bot
group surf_bot    id <> 289 432
144 atoms in group surf_bot
group molecules   id <> 433 1025
593 atoms in group molecules
group sub_bot     union layer_bot thermo_bot surf_bot
432 atoms in group sub_bot
group intercalate union surf_bot molecules
737 atoms in group intercalate
group mobile      union thermo_bot intercalate
953 atoms in group mobile

# ---------- potential ----------
pair_style      reaxff NULL
pair_coeff      * * ffield.reax.Fe_O_C_H ${elements}
pair_coeff      * * ffield.reax.Fe_O_C_H Fe O H
Reading potential file ffield.reax.Fe_O_C_H with DATE: 2011-02-18
fix             qeq all qeq/reaxff 1 0.0 10.0 1.0e-6 reaxff

# ---------- molecule counts ----------
# coordination of each O by H (cutoff 1.2 A) and of each H by H (0.9 A):
# water = O with 2 H; OH = O with 1 H; H2 = 2 H with 1 H neighbour each.
# Adjust the cutoffs to the first minimum of the RDF of your system.
group           atom_O type ${tO}
group           atom_O type 2
211 atoms in group atom_O
group           atom_H type ${tH}
group           atom_H type 3
382 atoms in group atom_H
compute         cn_OH atom_O coord/atom cutoff 1.2 group atom_H
compute         cn_HH atom_H coord/atom cutoff 0.9 group atom_H
variable        is_h2o atom "type==v_tO && c_cn_OH==2"
variable        is_oh  atom "type==v_tO && c_cn_OH==1"
variable        is_h2  atom "type==v_tH && c_cn_HH==1"
compute         n_h2o all reduce sum v_is_h2o
compute         n_oh  all reduce sum v_is_oh
compute         n_hh  all reduce sum v_is_h2
variable        n_h2  equal c_n_hh/2

# ---------- integration ----------
timestep        0.25                    # ps = 0.5 fs (H, high T)
variable        tdamp equal 100.0*dt
compute         temp_tbot thermo_bot temp/com
compute         temp_mol  molecules temp/com
compute         temp_surf surf_bot temp/com

fix             hold_bot  layer_bot   setforce 0.0 0.0 0.0
fix             nve_surf  surf_bot    nve
fix             wall      all wall/reflect zhi EDGE
fix             nvt_bot   thermo_bot  nvt temp ${T0} ${Th} ${tdamp}
fix             nvt_bot   thermo_bot  nvt temp 300 ${Th} ${tdamp}
fix             nvt_bot   thermo_bot  nvt temp 300 800 ${tdamp}
fix             nvt_bot   thermo_bot  nvt temp 300 800 25
fix_modify      nvt_bot   temp temp_tbot
WARNING: Temperature for fix modify is not for group all (src/fix_nh.cpp:1402)
fix             nvt_mol   molecules   nvt temp ${T0} ${Th} ${tdamp}
fix             nvt_mol   molecules   nvt temp 300 ${Th} ${tdamp}
fix             nvt_mol   molecules   nvt temp 300 800 ${tdamp}
fix             nvt_mol   molecules   nvt temp 300 800 25
fix_modify      nvt_mol   temp temp_mol
WARNING: Temperature for fix modify is not for group all (src/fix_nh.cpp:1402)

# ---------- output ----------
thermo          200
thermo_style    custom step time pe c_temp_mol c_temp_surf c_temp_tbot c_n_h2o c_n_oh v_n_h2
thermo_modify   flush yes
dump            traj all custom 2000 highT.lammpstrj id element xu yu zu
dump_modify     traj element ${elements} sort id format float %15.12g
dump_modify     traj element Fe O H sort id format float %15.12g
restart         100000 highT.*.restart

# ---------- 1. heat ----------
velocity        mobile create ${T0} 5191 dist gaussian mom yes rot no
velocity        mobile create 300 5191 dist gaussian mom yes rot no
velocity        layer_bot set 0.0 0.0 0.0
run             $(round(v_t_heat/dt))
run             4000

