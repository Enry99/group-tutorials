# Deposition (CVD/PVD-like): atoms (or molecules) are shot at the surface
# at regular intervals; in cycles, the atoms that bounced back or desorbed
# (no neighbours, far above the surface, moving up) are deleted, so they do
# not pile up under the top wall.
# Usage: sbatch job.sh deposition.in      Needs: Si001.data, Si001.groups.lmp
#
# Groups (interface.py --no-top): layer_bot fixed, thermo_bot thermostat,
# surf_bot NVE. The deposited atoms go to the group "deposited" (NVE).

# ---------- settings ----------
variable  model     string CHANGE_ME.model-mliap_lammps.pt   # MLIP in ML-IAP format (00_basics)
variable  elements  string "Si"           # element of each atom type, in the order of the data file
variable  type_dep  equal  1              # atom type deposited
variable  T         equal  1000           # K, substrate
variable  vz        equal  9.4            # A/ps towards the surface: sqrt(3 kB T/m) for Si at 1000 K
variable  every     equal  2000           # steps between two insertions (2 ps)
variable  ncycle    equal  10             # cycles ...
variable  nper      equal  10             # ... of nper insertions each (here 100 atoms in 200 ps)
variable  zin       equal  25.0           # A above the top of the substrate where atoms are inserted
# The film grows by about N/(n A): 100 Si (n = 0.05 atoms/A^3) on 236 A^2 = 8.5 A.
# Keep the insertion region well above the final film (zin, and the vacuum of
# the data file above it), or the insertions fail (WARNING: One or more particle
# depositions were unsuccessful).
variable  rcut      equal  3.0            # A, "no neighbour within rcut" = free atom

# ---------- system ----------
units           metal                     # A, ps, eV, bar, K
atom_style      atomic
boundary        p p f                     # z not periodic, closed by reflecting walls
processors      * * 1                     # no cut along z (several GPUs, see "load balance" below)
read_data       Si001.data
include         Si001.groups.lmp

# ---------- potential ----------
pair_style      mliap unified ${model} 0
pair_coeff      * * ${elements}

# ---------- load balance (several GPUs: jobscripts/lmp_node.sh; no effect on 1 GPU) ----------
# Subdomains are full-height columns (processors * * 1): compression along
# z does not move atoms between them and no GPU holds only vacuum. The
# columns are balanced in x, y by atom count and follow the atoms during
# sliding ("weight neigh" is skipped with Kokkos on GPUs). See
# troubleshooting.md, "GPU out of memory".
balance         1.0 shift xy 10 1.1
fix             lb all balance 1000 1.1 shift xy 10 1.1   # every 1000 steps, if imbalance > 10 %

# ---------- integration ----------
timestep        0.001                     # ps = 1 fs; 0.5 fs with H
variable        tdamp equal 100.0*dt
compute         temp_tbot thermo_bot temp/com
fix             hold_bot  layer_bot   setforce 0.0 0.0 0.0
fix             nvt_bot   thermo_bot  nvt temp ${T} ${T} ${tdamp}
fix_modify      nvt_bot   temp temp_tbot
fix             nve_surf  surf_bot    nve
fix             wall      all wall/reflect zlo EDGE zhi EDGE   # an atom crossing a z face is lost

# insertion region: a 5 A thick slab, zin above the substrate top
variable        ztop equal $(bound(sub_bot,zmax))
region          inject block EDGE EDGE EDGE EDGE $(v_ztop+v_zin) $(v_ztop+v_zin+5.0) units box
group           deposited empty
fix             nve_dep   deposited   nve
# N atoms, type, every M steps, seed; "near": minimum distance from other atoms;
# "id next": IDs never reused after a deletion (default: max ID + 1)
fix             dep deposited deposit $(v_ncycle*v_nper) ${type_dep} ${every} 48291 &
                region inject near 2.0 vz -${vz} -${vz} units box id next
# Molecules instead of atoms (e.g. SiH4 from a molecule file, see README):
#   molecule      sih4 SiH4.mol
#   fix           dep deposited deposit N 0 ${every} 48291 region inject near 2.0 &
#                 mol sih4 vz -${vz} -${vz} units box id next
compute         temp_dep deposited temp
compute_modify  temp_dep dynamic/dof yes      # the number of atoms changes

# ---------- free atoms, to be deleted ----------
compute         cn all coord/atom cutoff ${rcut}
# vz > 0: only atoms moving away from the surface (the ones just inserted
# are also free and high, but move down)
variable        is_free atom "c_cn==0 && vz>0 && z>v_ztop+5.0"
group           free dynamic all var is_free every ${every}
# For H2 (or N2) products, as in the CVD runs of the group:
#   compute     cn_HH atom_H coord/atom cutoff 0.9 group atom_H
#   variable    is_free atom "type==<H type> && c_cn_HH==1"

# ---------- output ----------
thermo          ${every}
thermo_style    custom step time atoms pe c_temp_tbot c_temp_dep
thermo_modify   flush yes
dump            traj all custom ${every} deposition.lammpstrj id element xu yu zu
dump_modify     traj element ${elements} sort id format float %15.12g

# ---------- run in cycles ----------
velocity        mobile create ${T} 3719 dist gaussian mom yes rot no
velocity        layer_bot set 0.0 0.0 0.0
variable        icycle loop ${ncycle}
label           cycle
  run           $(v_nper*v_every)
  delete_atoms  group free compress no     # keep the IDs of the other atoms
  write_restart deposition.restart
next            icycle
jump            SELF cycle
write_data      deposition.data nocoeff
