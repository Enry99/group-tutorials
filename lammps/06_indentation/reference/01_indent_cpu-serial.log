LAMMPS (22 Jul 2025 - Update 4)
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread.
  using 1 OpenMP thread(s) per MPI task
# Nanoindentation at constant speed: the tip is driven down into the slab,
# held, and pulled out (displacement control). The force on the driven
# layer vs its displacement gives the load-displacement curve.
# Usage: sbatch job.sh 01_indent.in
# Needs: Fe_tip_on_Fe.data and Fe_tip_on_Fe.groups.lmp (structures/tools/interface.py)
#
# Groups (interface.py): layer_bot fixed; thermo_bot/top thermostatted;
# surf_bot, surf_top (apex) and slide_top NVE; layer_top driven by fix move
# (it moves rigidly, no other integrator on it).

# ---------- settings ----------
variable  model     string CHANGE_ME.model-mliap_lammps.pt   # MLIP in ML-IAP format (00_basics)
variable  elements  string "Fe"           # element of each atom type, in the order of the data file
variable  T         equal  300            # K
variable  v         equal  10.0           # m/s indentation (and retraction) speed
variable  t_therm   equal  20             # ps, thermalization with the tip held in place
variable  depth     equal  8.0            # A of travel down (from the starting gap)
variable  t_hold    equal  20             # ps at the maximum depth

# ---------- system ----------
units           metal                     # A, ps, eV, bar, K
atom_style      atomic
boundary        p p p
read_data       Fe_tip_on_Fe.data
Reading data file ...
  orthogonal box = (0 0 0) to (37.230432 35.101188 39.649976)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  2133 atoms
  read_data CPU = 0.004 seconds
include         Fe_tip_on_Fe.groups.lmp
# groups for Fe_tip_on_Fe.data, written by interface.py
group layer_bot   id <> 1 225
225 atoms in group layer_bot
group thermo_bot  id <> 226 900
675 atoms in group thermo_bot
group surf_bot    id <> 901 1800
900 atoms in group surf_bot
group surf_top    id <> 1801 1821
21 atoms in group surf_top
group thermo_top  id <> 1822 1975
154 atoms in group thermo_top
group slide_top   id <> 1976 2024
49 atoms in group slide_top
group layer_top   id <> 2025 2133
109 atoms in group layer_top
group sub_bot     union layer_bot thermo_bot surf_bot
1800 atoms in group sub_bot
group sub_top     union layer_top slide_top thermo_top surf_top
333 atoms in group sub_top
group intercalate union surf_bot surf_top
921 atoms in group intercalate
group mobile      union thermo_bot intercalate thermo_top slide_top
1799 atoms in group mobile
variable    load_force equal -0.05181025147   # eV/A per atom: 2.0 GPa on 452.40 A^2, 109 atoms

# ---------- potential ----------
pair_style      eam/fs
pair_coeff      * * Fe_mm.eam.fs ${elements}
pair_coeff      * * Fe_mm.eam.fs Fe
Reading eam/fs potential file Fe_mm.eam.fs with DATE: 2007-06-11

# ---------- integration ----------
timestep        0.001                     # ps = 1 fs; 0.5 fs with H
variable        tdamp equal 100.0*dt
compute         temp_tbot thermo_bot temp/com
compute         temp_ttop thermo_top temp/com
compute         temp_int  intercalate temp/com

fix             hold_bot  layer_bot   setforce 0.0 0.0 0.0
fix             nvt_bot   thermo_bot  nvt temp ${T} ${T} ${tdamp}
fix             nvt_bot   thermo_bot  nvt temp 300 ${T} ${tdamp}
fix             nvt_bot   thermo_bot  nvt temp 300 300 ${tdamp}
fix             nvt_bot   thermo_bot  nvt temp 300 300 0.1
fix_modify      nvt_bot   temp temp_tbot
WARNING: Temperature for fix modify is not for group all (src/fix_nh.cpp:1402)
fix             nvt_top   thermo_top  nvt temp ${T} ${T} ${tdamp}
fix             nvt_top   thermo_top  nvt temp 300 ${T} ${tdamp}
fix             nvt_top   thermo_top  nvt temp 300 300 ${tdamp}
fix             nvt_top   thermo_top  nvt temp 300 300 0.1
fix_modify      nvt_top   temp temp_ttop
WARNING: Temperature for fix modify is not for group all (src/fix_nh.cpp:1402)
group           free      union intercalate slide_top
970 atoms in group free
fix             nve_free  free        nve

# ---------- output ----------
# fcm(layer_top,z): z force of the system on the driven layer (eV/A, total
# over the group; positive = the slab pushes the tip up)
variable        ztip equal xcm(layer_top,z)
variable        fztip equal fcm(layer_top,z)
variable        fxtip equal fcm(layer_top,x)
thermo          200
thermo_style    custom step time pe c_temp_int c_temp_tbot c_temp_ttop v_ztip v_fztip v_fxtip
thermo_modify   flush yes
dump            traj all custom 2000 01_indent.lammpstrj id element xu yu zu
dump_modify     traj element ${elements} sort id format float %15.12g
dump_modify     traj element Fe sort id format float %15.12g

# ---------- 1. thermalization, tip held ----------
velocity        mobile create ${T} 2755 dist gaussian mom yes rot yes
velocity        mobile create 300 2755 dist gaussian mom yes rot yes
velocity        layer_top set 0.0 0.0 0.0
velocity        layer_bot set 0.0 0.0 0.0
fix             drive layer_top move linear 0.0 0.0 0.0 units box
run             $(round(v_t_therm/dt))
run             20000
